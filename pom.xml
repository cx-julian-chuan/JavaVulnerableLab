<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>org.cysecurity</groupId>
  <artifactId>JavaVulnerableLab</artifactId>
  <packaging>war</packaging>
  <version>0.0.1-SNAPSHOT</version>
  <name>JavaVulnerableLab Maven Webapp</name>
  <url>http://maven.apache.org</url>
  <dependencies>
    <dependency>
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
      <version>4.13.2</version>
      <scope>test</scope>
    </dependency>
    <dependency>
    	<groupId>mysql</groupId>
    	<artifactId>mysql-connector-java</artifactId>
    	<version>5.1.26</version>
    </dependency>
    <dependency>
	    <groupId>org.json</groupId>
	    <artifactId>json</artifactId>
	    <version>20090211</version>
	</dependency>
	<dependency>
		<groupId>javax.servlet</groupId>
		<artifactId>jstl</artifactId>
		<version>1.2</version>
	</dependency>
	<dependency>
		<groupId>org.hibernate</groupId>
		<artifactId>hibernate-core</artifactId>
		<version>4.0.1.Final</version>
	</dependency>
	<dependency>
    <groupId>javax.servlet</groupId>
    <artifactId>servlet-api</artifactId>
    <version>2.3</version>
    <scope>provided</scope>
</dependency>
	<!-- OWASP 2025 A03 Software Supply Chain: log4j 2.12.1 is the Java 7 branch
	     and is still vulnerable to Log4Shell (CVE-2021-44228). 2.12.2 fixed it. -->
	<dependency>
		<groupId>org.apache.logging.log4j</groupId>
		<artifactId>log4j-api</artifactId>
		<version>2.12.1</version>
	</dependency>
	<dependency>
		<groupId>org.apache.logging.log4j</groupId>
		<artifactId>log4j-core</artifactId>
		<version>2.12.1</version>
	</dependency>
	<!-- OWASP 2025 A08 Software or Data Integrity Failures: commons-collections
	     3.1 (2004) carries the InvokerTransformer gadget used by ysoserial's
	     CommonsCollections chains. On the classpath it turns the raw
	     ObjectInputStream in vulnerability/deserialize/preferences.jsp into RCE
	     (CWE-502). Fixed by upgrading to 3.2.2 + a deserialization allow-list. -->
	<dependency>
		<groupId>commons-collections</groupId>
		<artifactId>commons-collections</artifactId>
		<version>3.1</version>
	</dependency>
	<!-- OWASP 2025 A06 Insecure Design: file upload with no type restriction
	     (CWE-434). commons-fileupload 1.3.x + commons-io are Java 7 compatible. -->
	<dependency>
		<groupId>commons-fileupload</groupId>
		<artifactId>commons-fileupload</artifactId>
		<version>1.3.3</version>
	</dependency>
	<dependency>
		<groupId>commons-io</groupId>
		<artifactId>commons-io</artifactId>
		<version>2.6</version>
	</dependency>
	<!-- Build-environment fix, not a vulnerability fix: javax.xml.bind (JAXB) was
	     bundled in the JDK through Java 8 and removed in 11+. preferences.jsp and
	     JwtUtil.java both import it. Restoring it as an explicit dependency lets
	     the project build on a modern JDK without changing the app's own code. -->
	<dependency>
		<groupId>javax.xml.bind</groupId>
		<artifactId>jaxb-api</artifactId>
		<version>2.3.1</version>
	</dependency>
	<dependency>
		<groupId>org.glassfish.jaxb</groupId>
		<artifactId>jaxb-runtime</artifactId>
		<version>2.3.1</version>
	</dependency>
	<!-- OWASP 2025 A08 Software or Data Integrity Failures / malicious package:
	     org.mvnpm:posthog-node:4.18.1 is a real, OSV-confirmed malicious package
	     (MAL-2025-191470, published 2025-11-26) — the Shai-Hulud 2.0 supply-chain
	     attack mirrored a compromised npm posthog-node release into Maven Central
	     via the mvnpm bridge. Credential-harvesting payload. This exact version has
	     since been pulled from Maven Central (confirmed 404 on repo1.maven.org) —
	     mvn dependency:tree tolerates the missing POM as a warning and still lists
	     the coordinate; a full mvn compile fails to resolve it. Untested whether
	     Checkmarx One's SCA scan needs full resolution or works off the declared
	     coordinate the way it already tolerates this project's other build issues. -->
	<dependency>
		<groupId>org.mvnpm</groupId>
		<artifactId>posthog-node</artifactId>
		<version>4.18.1</version>
	</dependency>
  </dependencies>
  <build>
    <finalName>JavaVulnerableLab</finalName>
  </build>
    <properties>
        <!-- Bumped from 1.7: build-environment fix so this compiles on a modern
             JDK (source/target 7 was removed by javac in later JDK releases).
             Not a vulnerability fix, doesn't change any finding in this repo. -->
        <maven.compiler.source>1.8</maven.compiler.source>
        <maven.compiler.target>1.8</maven.compiler.target>
    </properties>
</project>
